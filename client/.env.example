# LabelMate client environment — copy to ".env.local" and fill in real values.
# Never commit ".env.local". Next.js loads it automatically.
# Only variables prefixed with NEXT_PUBLIC_ reach the browser.

# Base URL of the Spring Boot API (no trailing slash).
# Local dev backend: http://localhost:8080
# Docker Compose: http://localhost:8080
NEXT_PUBLIC_API_URL=
