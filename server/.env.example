# LabelMate server environment — copy to ".env" and fill in real values.
# Never commit ".env". This file documents every variable the server reads.
#
# Spring Boot loads "server/.env" automatically via DotenvLoader
# (server/.../config/DotenvLoader.java) when you run from the server/
# directory. Plain KEY=value lines, "#" comments, an optional "export"
# prefix, and one pair of matching quotes are supported.
# Docker Compose instead uses the root ".env" — keep the shared values
# (database, JWT, AI) identical in both files.
#
# Rule: secrets are REQUIRED (no defaults anywhere in code).
# Non-secret local/dev defaults live in application.properties and can be
# overridden here when needed.

# --- Database (MySQL 8) ---
# Full JDBC URL for the app's own database. Points at the compose "mysql"
# service as exposed on the host — keep host/port/user/password identical
# to the root .env (DB_* values) so local runs and containers share one DB.
DATABASE_URL=jdbc:mysql://localhost:3306/labelmate?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DATABASE_USERNAME=labelmate
# REQUIRED — no default. Use a strong password; generate with: openssl rand -hex 16
DATABASE_PASSWORD=

# --- Auth ---
# REQUIRED — at least 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION_MS=86400000

# --- CORS (comma-separated, no wildcard) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Dataset file uploads ---
UPLOAD_DIR=uploads
UPLOAD_MAX_IMAGE_MB=5

# --- AI assistance (optional, off by default) ---
APP_AI_ENABLED=false
SPRING_AI_MODEL_CHAT=none
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=openrouter/auto
AI_MAX_PROMPT_CHARS=4000
AI_REQUEST_TIMEOUT_SECONDS=30
