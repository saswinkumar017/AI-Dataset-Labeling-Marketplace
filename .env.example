# Copy to ".env" and fill in real values. Never commit ".env".
# All values here are placeholders, not real credentials.
#
# This file feeds "docker compose up" only. The apps also each own their
# environment for non-Docker runs: server/.env.example and
# client/.env.example. Keep the shared values (database, JWT, AI)
# identical across all three files.

# --- MySQL ---
DB_ROOT_PASSWORD=change-me-root
DB_NAME=labelmate
DB_USER=labelmate
DB_PASSWORD=change-me-db

# --- Backend ---
# At least 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-secret-at-least-32-chars-long
JWT_EXPIRATION_MS=86400000
CORS_ALLOWED_ORIGINS=http://localhost:3000
UPLOAD_MAX_IMAGE_MB=5

# --- AI assistance (optional, off by default) ---
APP_AI_ENABLED=false
SPRING_AI_MODEL_CHAT=none
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=openrouter/auto

# --- Registration OTP (two-step email verification) ---
OTP_EXPIRY_SECONDS=600
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAIL_FROM=LabelMate <no-reply@labelmate.local>

# --- SMTP delivery for OTP codes (optional, empty = log codes server-side) ---
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=true

# --- Frontend ---
# Browser-facing backend URL, baked into the client image at build time.
CLIENT_API_URL=http://localhost:8080
